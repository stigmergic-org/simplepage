{
  "name": "root",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.3.0",
  "engines": {
    "node": "24.x",
    "pnpm": ">=11.3.0"
  },
  "scripts": {
    "pretest": "pnpm --filter @simplepg/test-utils run ensure-kubo",
    "setup": "pnpm install; cd contracts && forge install",
    "build": "pnpm -r build",
    "dev": "pnpm -r dev",
    "cli:local-node": "node ./scripts/run-cli-local-node.js",
    "node:dev:no-indexer": "pnpm --filter @simplepg/node run dev:no-indexer",
    "frontend:dev:local-node": "pnpm --filter @simplepg/frontend run dev:local-node",
    "test": "pnpm -r test",
    "stage": "cd frontend; pnpm run stage",
    "stage-sepolia": "cd frontend; pnpm run stage-sepolia",
    "lint": "pnpm -r lint"
  },
  "workspaces": [
    "packages/*",
    "frontend"
  ],
  "devDependencies": {
    "@changesets/cli": "^2.29.5",
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^5.1.0",
    "globals": "^15.14.0"
  }
}
